PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=<long random string>

# TURN relay (optional locally; needed in production for users behind strict NAT / mobile data)
# Option A: Cloudflare Realtime TURN (short-lived credentials generated server-side)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Option B: static TURN credentials, comma-separated URLs (e.g. Metered Open Relay)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
